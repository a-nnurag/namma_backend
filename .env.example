# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8001
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/nammakelsa_backend

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_DB=2

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ADAPTER_BACKEND=aiokafka   # aiokafka | mock
# Upstash Kafka (production) — set USE_SSL=true and fill SASL credentials
KAFKA_USE_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── Twilio (OTP) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Aadhaar Verification (Strategy Pattern) ───────────────────────────────────
AADHAAR_VERIFIER_BACKEND=mock    # mock | surepass | signzy
SUREPASS_API_KEY=
SUREPASS_API_URL=https://kyc-api.surepass.io/api/v1/aadhaar-v2/generate-otp
SIGNZY_API_KEY=
SIGNZY_API_URL=

# ── Face Hash (Strategy Pattern) ──────────────────────────────────────────────
FACE_HASH_STRATEGY=sha256        # sha256 | blake2 | md5
FACE_SIMILARITY_THRESHOLD=0.85
FACE_DETECTION_CONFIDENCE=0.9
FACE_VIDEO_MAX_SIZE_MB=10

# ── Workexp Video ─────────────────────────────────────────────────────────────
MAX_WORKEXP_VIDEO_SIZE_MB=100
WORKEXP_CHUNK_SIZE_BYTES=65536
KAFKA_CHUNK_SIZE_BYTES=262144

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── ML Service ────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8000
ML_POLL_INTERVAL_SECONDS=30

# ── SarvamAI (STT/TTS) ────────────────────────────────────────────────────────
SARVAM_API_KEY=

# ── Groq (Chatbot LLM) ────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── File Storage ──────────────────────────────────────────────────────────────
LOCAL_STORAGE_DIR=/tmp/backend

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
